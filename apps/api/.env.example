# Copy to apps/api/.env and fill in. Never commit the real .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string. Include the database name after .net/ (here GPT_LMS),
# otherwise Atlas uses its default "test" database. Local alternative (npm run db:local):
# MONGODB_URI=mongodb://127.0.0.1:27018/GPT_LMS?replicaSet=local
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/GPT_LMS?retryWrites=true&w=majority

# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=1d

# Comma-separated origins allowed to call the API directly (the Vercel rewrite is same-origin)
CLIENT_ORIGIN=http://localhost:3000

# OpenAI, server side only. Paste the key on ONE line (about 160 characters; turn off word
# wrap if your editor splits it). Check it once with: npm run ai:check
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_TIMEOUT_MS=20000
# Optional, for reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=
# Recommendation requests per user per 15 minutes
AI_RATE_LIMIT=10
# Same, for guests (counted per IP)
AI_GUEST_RATE_LIMIT=5

# Proxies in front of the API: 1 = Nginx only; 2 = Vercel rewrite + Nginx (production).
# Check with GET /api/health, which shows the client IP the API sees.
TRUST_PROXY=1

# Used by `npm run create-superadmin` (and by `npm run seed` if set)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Password for every seeded demo account (default Password123!)
SEED_PASSWORD=
