{
  "name": "@lp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsx build.ts",
    "start": "node --env-file-if-exists=.env --enable-source-maps dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env src/scripts/seed.ts",
    "create-superadmin": "tsx --env-file-if-exists=.env src/scripts/createSuperAdmin.ts",
    "db:local": "tsx src/scripts/localDb.ts",
    "docs:openapi": "tsx src/scripts/exportOpenapi.ts"
  },
  "dependencies": {
    "@lp/shared": "*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.1",
    "morgan": "^1.12.1",
    "openai": "^7.18.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "esbuild": "^0.28.2",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "vitest": "^5.0.1"
  }
}
