# Base URL of the Express API. /api/* is rewritten to `${API_URL}/api/*`.
# Local: http://localhost:5000   Same server as the API (.env.production): http://127.0.0.1:5000
# On Vercel (env var): the API's HTTPS URL, e.g. https://api.your-domain.com
API_URL=http://localhost:5000

# Show one-click demo accounts on the login page (set to false to hide)
NEXT_PUBLIC_DEMO_MODE=true
