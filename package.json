{
  "name": "GPT_LMS",
  "private": false,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @lp/api\" \"npm run dev -w @lp/web\"",
    "dev:api": "npm run dev -w @lp/api",
    "dev:web": "npm run dev -w @lp/web",
    "build": "npm run build -w @lp/web",
    "test": "npm test -w @lp/api",
    "seed": "npm run seed -w @lp/api",
    "create-superadmin": "npm run create-superadmin -w @lp/api",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{js,jsx,mjs,cjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,mjs,cjs,json,css,md}\"",
    "docs:openapi": "npm run docs:openapi -w @lp/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.3",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "^3.9.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "type": "module"
}
